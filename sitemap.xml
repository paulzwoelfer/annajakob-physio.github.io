---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.html_pages | sort: "url" %}
  {% for node in sitemap_pages %}
    {% unless node.url contains "/404" %}
      <url>
        <loc>{{ node.url | absolute_url | xml_escape }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>{% if node.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
        <priority>{% if node.url == "/" %}1.0{% else %}0.8{% endif %}</priority>
      </url>
    {% endunless %}
  {% endfor %}
</urlset>
